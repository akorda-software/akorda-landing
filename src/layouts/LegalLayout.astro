---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<BaseLayout title={title} description={`${title} — akorda`} noindex>
  <section class="mx-auto max-w-3xl px-5 pb-24 pt-32 md:px-8 md:pt-44">
    <h1 class="hero-enter font-display text-4xl font-semibold tracking-tight text-ink md:text-5xl">
      {title}
    </h1>
    <p class="mt-3 text-sm text-ink-faint">Última actualización: {updated}</p>
    <div
      class="mt-10 space-y-6 leading-relaxed text-ink-soft [&>h2]:font-display [&>h2]:mt-10 [&>h2]:text-2xl [&>h2]:font-semibold [&>h2]:tracking-tight [&>h2]:text-ink [&>p]:mt-3 [&>ul]:mt-3 [&>ul]:list-disc [&>ul]:space-y-2 [&>ul]:pl-6"
    >
      <slot />
    </div>
  </section>
</BaseLayout>
