---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<!-- Lockup clásico: monograma al tamaño de las letras + wordmark completo -->
<a href="/" class:list={['flex items-center gap-2', className]} aria-label="akorda — inicio">
  <img src="/logo.png" alt="" aria-hidden="true" width="861" height="713" class="h-6 w-auto dark:hidden" />
  <img src="/logo-white.png" alt="" aria-hidden="true" width="861" height="713" class="hidden h-6 w-auto dark:block" />
  <span class="font-display text-xl font-semibold lowercase tracking-tight text-ink">
    akorda
  </span>
</a>
