---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<!-- Lockup integrado: el monograma aporta la A y la K, el texto solo "orda" -->
<a href="/" class:list={['flex items-center gap-1.5', className]} aria-label="akorda — inicio">
  <img src="/logo.png" alt="" aria-hidden="true" width="861" height="713" class="h-9 w-auto dark:hidden" />
  <img src="/logo-white.png" alt="" aria-hidden="true" width="861" height="713" class="hidden h-9 w-auto dark:block" />
  <span class="font-display -translate-y-[1px] text-xl font-semibold lowercase tracking-tight text-ink">
    orda
  </span>
</a>
