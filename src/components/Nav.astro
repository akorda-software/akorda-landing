---
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;

const links = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 border-b border-line/70 bg-paper/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:h-[72px] md:px-8">
    <Logo />

    <nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-[15px] font-medium transition-colors',
              isActive(link.href) ? 'text-accent' : 'text-ink-soft hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <button
        class="theme-btn flex h-9 w-9 items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:border-ink hover:text-ink"
        aria-label="Cambiar entre tema claro y oscuro"
      >
        <svg class="icon-sun hidden h-[18px] w-[18px] dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386 1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"></path>
        </svg>
        <svg class="icon-moon h-[18px] w-[18px] dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 12 21.75a9.753 9.753 0 0 0 9.752-6.748Z"></path>
        </svg>
      </button>
      <a
        href="/contacto"
        class="rounded-full bg-ink px-4 py-2 text-[15px] font-medium text-paper transition-all hover:bg-accent active:scale-[0.98]"
      >
        Cuéntanos tu problema
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <button
        class="theme-btn flex h-10 w-10 items-center justify-center rounded-full border border-line bg-paper"
        aria-label="Cambiar entre tema claro y oscuro"
      >
        <svg class="icon-sun hidden h-5 w-5 text-ink dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386 1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"></path>
        </svg>
        <svg class="icon-moon h-5 w-5 text-ink dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 12 21.75a9.753 9.753 0 0 0 9.752-6.748Z"></path>
        </svg>
      </button>
      <button
        id="menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-line bg-paper md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg class="h-5 w-5 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-paper px-5 pb-6 pt-3 md:hidden"
  >
    <nav class="flex flex-col" aria-label="Menú móvil">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'border-b border-line py-3.5 text-lg font-medium',
              isActive(link.href) ? 'text-accent' : 'text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="mt-5 rounded-full bg-ink px-4 py-3 text-center text-[15px] font-medium text-paper"
      >
        Cuéntanos tu problema
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    if (icon) {
      icon.setAttribute(
        'd',
        open ? 'M6 18 18 6M6 6l12 12' : 'M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5',
      );
    }
  });

  document.querySelectorAll('.theme-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('akorda-theme', next);
      } catch {
        /* sin almacenamiento disponible */
      }
    });
  });
</script>
