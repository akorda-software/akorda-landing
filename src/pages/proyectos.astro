---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';

type Featured = {
  id: string;
  name: string;
  tag: string;
  tagline: string;
  desc: string;
  points: string[];
  stack: string[];
  status: string;
  href: string;
  domain: string;
  img: string;
  /** rgb sin alfa, para el halo y los detalles del producto */
  glow: string;
  badge: { k: string; v: string };
  /** encuadre de la captura dentro del marco */
  fit?: string;
};

const featured: Featured[] = [
  {
    id: 'kaselles',
    name: 'Kaselles',
    tag: 'Escritorio · IA',
    tagline: 'Tu horario no se hace. Se calcula.',
    desc: 'Generador de horarios para colegios, institutos, universidades, FP y academias. Describes tu centro a un agente de IA, revisas lo que ha configurado y un motor de restricciones calcula un horario viable.',
    points: [
      'Motor de optimización con restricciones reales (OR-Tools CP-SAT)',
      'Un agente de IA configura profesores, grupos, aulas y reglas por ti',
      'Proyectos locales: los datos del centro no salen de tu ordenador',
    ],
    stack: ['Tauri', 'Rust', 'React', 'Python', 'Phoenix'],
    status: 'Disponible',
    href: 'https://kaselles.com',
    domain: 'kaselles.com',
    img: '/images/proyectos/kaselles.webp',
    glow: '221 150 40',
    badge: { k: 'Plataformas', v: 'Windows · macOS · Linux' },
  },
  {
    id: 'taket',
    name: 'Taket',
    tag: 'SaaS · Eventos',
    tagline: 'La puerta de tu evento, bajo control.',
    desc: 'Control de acceso y aforo por QR. Importas la lista de asistentes, envías las entradas y escaneas con cualquier móvil, también sin conexión. Sabes quién ha entrado, cuánta gente hay dentro y tienes el informe al terminar.',
    points: [
      'Su núcleo nació para un evento corporativo de unas 3.500 personas',
      'Varias puertas a la vez, aforo en directo y modo sin conexión',
      'Sin lectores, sin hardware propio y sin comisión por entrada',
    ],
    stack: ['Elixir', 'Phoenix LiveView', 'PostgreSQL'],
    status: 'En producción',
    href: 'https://taket.app',
    domain: 'taket.app',
    img: '/images/proyectos/taket.webp',
    glow: '76 205 115',
    badge: { k: 'Pruebas de carga', v: '~200 escaneos/s' },
  },
  {
    id: 'dragonex',
    name: 'Dragonex',
    tag: 'Juego web · IA',
    tagline: 'Un máster de rol que no hace trampas con los dados.',
    desc: 'Partidas de Dungeons & Dragons 5e dirigidas por IA, solo o con amigos. El modelo de lenguaje solo narra: cada tirada, ataque y salvación la resuelve un motor que aplica las reglas. La historia es libre; los números, honestos.',
    points: [
      'Agentes de IA con herramientas: el LLM narra y el código arbitra',
      'Construido sobre exAgent, nuestro framework de agentes publicado en Hex',
      'Integración continua y despliegue automático tras cada cambio',
    ],
    stack: ['Elixir', 'Phoenix LiveView', 'exAgent', 'LLMs'],
    status: 'En producción',
    href: 'https://dragones.kukapu.dev',
    domain: 'dragones.kukapu.dev',
    img: '/images/proyectos/dragonex.webp',
    glow: '255 120 40',
    badge: { k: 'Tests en cada despliegue', v: '+3.300' },
  },
  {
    id: 'kordia',
    name: 'Kordia',
    tag: 'SaaS · Equipos',
    tagline: 'Reparte las horas de tu equipo entre proyectos.',
    desc: 'Planifica la capacidad y la carga de trabajo de tu equipo. Asignas personas a proyectos por jornada o por horas totales y ves al momento cuánto presupuesto, en horas y en euros, queda cubierto.',
    points: [
      'Detecta topes anuales y solapes antes de cerrar la planificación',
      'Presupuesto en horas y euros cubierto en tiempo real',
      'API y servidor MCP: también se maneja desde tu agente de IA',
    ],
    stack: ['Elixir', 'Phoenix LiveView', 'PostgreSQL', 'MCP'],
    status: 'En producción',
    href: 'https://kordia.es',
    domain: 'kordia.es',
    img: '/images/proyectos/kordia.webp',
    glow: '80 90 255',
    badge: { k: 'Para tu agente de IA', v: 'Servidor MCP' },
    fit: 'object-left-top',
  },
];

const stats = [
  { n: '7', label: 'productos propios' },
  { n: '6', label: 'ya publicados y en uso' },
  { n: '4', label: 'proyectos a medida en marcha' },
  { n: '3', label: 'plataformas: web, escritorio y móvil' },
];

const index = [
  ...featured.map((p) => ({ id: p.id, name: p.name })),
  { id: 'cherry', name: 'Cherry' },
  { id: 'audibleport', name: 'AudiblePort' },
  { id: 'ticketsplitter', name: 'TicketSplitter' },
];

const tech = [
  'Elixir',
  'Phoenix LiveView',
  'PostgreSQL',
  'React',
  'TypeScript',
  'Rust',
  'Tauri',
  'Expo',
  'React Native',
  'Python',
  'NestJS',
  'Agentes de IA',
  'MCP',
  'Docker',
];

const clients = [
  {
    name: 'Mercury Brokers',
    sector: 'Seguros de transporte',
    status: 'En pruebas con el cliente',
    before: 'Expedientes, facturas y certificados de seguro de mercancías preparados a mano, documento a documento.',
    after: 'Backoffice que lee la documentación con IA, calcula primas y genera certificados y recibos, siempre con revisión humana, tarifas versionadas y auditoría.',
    stack: ['Elixir', 'Phoenix LiveView', 'PostgreSQL', 'IA'],
  },
  {
    name: 'CodiSL',
    sector: 'Construcción',
    status: 'En desarrollo',
    before: 'Varias hojas de cálculo para costes de obra, facturación y nóminas que había que cuadrar entre sí.',
    after: 'Una aplicación interna centrada en la obra: operarios, materiales y autónomos, facturación, margen y liquidación mensual en un único lugar.',
    stack: ['React', 'NestJS', 'PostgreSQL'],
  },
  {
    name: 'AquaSalud',
    sector: 'Distribución y servicios',
    status: 'En desarrollo',
    before: 'Una aplicación antigua sobre la que la empresa había perdido el control.',
    after: 'Un mini-ERP hecho a medida que le devuelve el control sobre su herramienta y sobre sus datos.',
    stack: ['React', 'NestJS', 'PostgreSQL'],
  },
  {
    name: 'Control de accesos',
    sector: 'Eventos',
    status: 'En desarrollo',
    before: 'Miles de asistentes, varias puertas y ninguna forma fiable de saber quién había entrado.',
    after: 'Plataforma para gestionar miles de códigos QR desde varios dispositivos, con entradas, salidas y aforo en tiempo real.',
    stack: ['Elixir', 'Phoenix LiveView', 'PostgreSQL'],
  },
];

const receipt = [
  { item: 'Paella valenciana', price: '33,00', who: ['A', 'Ó'], color: ['#7b61ff', '#f2a93b'] },
  { item: 'Esgarraet', price: '9,50', who: ['M'], color: ['#3bb273'] },
  { item: 'Croquetas caseras', price: '9,00', who: ['Común'], color: [] },
  { item: 'Agua de Valencia', price: '18,00', who: ['A', 'M', 'Ó'], color: ['#7b61ff', '#3bb273', '#f2a93b'] },
];
---

<BaseLayout
  title="Proyectos"
  description="Productos propios de akorda en producción: Kaselles, Taket, Dragonex, Kordia, AudiblePort y TicketSplitter, además de Cherry. Y software a medida en marcha con clientes como Mercury Brokers."
>
  <!-- ============ HERO ============ -->
  <section id="hero" class="relative overflow-hidden pt-16 md:pt-[72px]">
    <div aria-hidden="true" class="absolute inset-0" data-parallax="0.06">
      <div class="aurora">
        <div class="blob blob-a"><div data-depth="10"><i></i></div></div>
        <div class="blob blob-b"><div data-depth="22"><i></i></div></div>
        <div class="blob blob-c"><div data-depth="14"><i></i></div></div>
      </div>
    </div>
    <div aria-hidden="true" class="absolute inset-0" data-parallax="0.12">
      <div class="hero-grid absolute inset-0"></div>
      <div class="dot-grid absolute inset-0"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-16 md:px-8 md:pb-24 md:pt-24">
      <div data-hero-fade>
        <p
          class="hero-enter inline-flex items-center gap-2 rounded-full border border-line bg-paper/80 px-4 py-1.5 text-sm font-medium text-ink-soft backdrop-blur"
        >
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          Proyectos
        </p>
        <h1
          class="hero-enter font-display mt-7 max-w-4xl text-[2.6rem] font-semibold leading-[1.04] tracking-tight text-ink md:text-7xl"
          style="--enter-delay: 80ms"
        >
          Lo que construimos <span class="italic text-accent">habla por nosotros</span>.
        </h1>
        <p class="hero-enter mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl" style="--enter-delay: 160ms">
          Productos propios que hemos diseñado, lanzado y mantenemos, y los primeros proyectos a medida con
          clientes. Todavía no tenemos casos de cliente terminados que contar; lo que sí tenemos es software
          real, en producción, que puedes probar ahora mismo.
        </p>

        <dl
          class="hero-enter mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4"
          style="--enter-delay: 240ms"
        >
          {stats.map((s) => (
            <div class="bg-paper/85 px-5 py-5 backdrop-blur md:px-6 md:py-6">
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-semibold tracking-tight text-ink md:text-5xl">{s.n}</dd>
              <dd class="mt-1 text-sm leading-snug text-ink-soft">{s.label}</dd>
            </div>
          ))}
        </dl>

        <nav aria-label="Índice de proyectos" class="hero-enter mt-8 flex flex-wrap items-center gap-2" style="--enter-delay: 320ms">
          <span class="mr-1 text-sm text-ink-faint">Ir a</span>
          {index.map((p) => (
            <a
              href={`#${p.id}`}
              class="rounded-full border border-line bg-paper/70 px-3.5 py-1.5 text-sm font-medium text-ink-soft backdrop-blur transition-colors hover:border-accent hover:text-accent"
            >
              {p.name}
            </a>
          ))}
          <a
            href="#clientes"
            class="rounded-full border border-accent/40 bg-accent-tint px-3.5 py-1.5 text-sm font-medium text-accent-strong transition-colors hover:border-accent"
          >
            Con clientes
          </a>
        </nav>
      </div>
    </div>
  </section>

  <!-- ============ TECNOLOGÍAS ============ -->
  <div class="marquee overflow-hidden border-y border-line bg-paper-deep py-4" aria-label="Tecnologías con las que construimos">
    <div class="marquee-track flex w-max items-center gap-10 pr-10" style="--marquee-duration: 50s">
      {[...tech, ...tech].map((t) => (
        <span class="flex items-center gap-10 whitespace-nowrap text-[15px] font-medium text-ink-soft">
          {t}
          <span aria-hidden="true" class="text-accent">·</span>
        </span>
      ))}
    </div>
  </div>

  <!-- ============ PRODUCTOS PROPIOS ============ -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-5 pt-20 md:px-8 md:pt-32">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Productos propios</p>
        <h2 class="font-display mt-5 text-3xl font-semibold tracking-tight text-ink md:text-5xl">
          Nadie nos los encargó. Por eso son la mejor prueba.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          Los hemos llevado de la idea a producción con nuestro tiempo y nuestro dinero: diseño, código,
          infraestructura, pagos y soporte. Es exactamente lo que haríamos con tu proyecto.
        </p>
      </div>

      <div class="mt-16 space-y-24 md:mt-24 md:space-y-36">
        {featured.map((p, i) => {
          const flip = i % 2 === 1;
          return (
            <article id={p.id} class="grid scroll-mt-28 items-center gap-10 lg:grid-cols-12 lg:gap-16" style={`--p: ${p.glow}`}>
              <div class={`order-2 lg:col-span-5 ${flip ? 'lg:order-2' : 'lg:order-1'}`} data-reveal>
                <div class="flex items-center gap-3">
                  <span class="font-display text-sm font-semibold tabular-nums text-ink-faint">0{i + 1}</span>
                  <span class="h-px w-8 bg-line"></span>
                  <span class="text-xs font-semibold uppercase tracking-wider text-accent">{p.tag}</span>
                </div>
                <h3 class="font-display mt-4 text-4xl font-semibold tracking-tight text-ink md:text-6xl">{p.name}</h3>
                <p class="font-display mt-3 text-xl font-medium leading-snug text-ink md:text-2xl">
                  <span class="product-mark">{p.tagline}</span>
                </p>
                <p class="mt-5 leading-relaxed text-ink-soft">{p.desc}</p>
                <ul class="mt-6 space-y-3">
                  {p.points.map((pt) => (
                    <li class="flex gap-3 text-[15px] leading-snug text-ink">
                      <span aria-hidden="true" class="product-dot mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full"></span>
                      {pt}
                    </li>
                  ))}
                </ul>
                <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
                  {p.stack.map((s) => (
                    <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-soft">{s}</li>
                  ))}
                </ul>
                <div class="mt-8 flex flex-wrap items-center gap-4">
                  <a
                    href={p.href}
                    target="_blank"
                    rel="noopener"
                    data-magnetic
                    class="group inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-[filter] hover:brightness-125"
                  >
                    Visitar {p.domain}
                    <span aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
                  </a>
                  <span class="inline-flex items-center gap-2 text-sm font-medium text-ink-soft">
                    <span class="relative flex h-2 w-2">
                      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
                      <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                    </span>
                    {p.status}
                  </span>
                </div>
              </div>

              <div class={`order-1 lg:col-span-7 ${flip ? 'lg:order-1' : 'lg:order-2'}`} data-reveal style="--reveal-delay: 120ms">
                <div class="relative">
                  <div aria-hidden="true" class="product-glow"></div>
                  <a href={p.href} target="_blank" rel="noopener" data-tilt class="browser relative block" aria-label={`Abrir ${p.name}`}>
                    <div class="browser-bar">
                      <span class="flex gap-1.5" aria-hidden="true">
                        <i class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></i>
                        <i class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></i>
                        <i class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></i>
                      </span>
                      <span class="browser-url">
                        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3 w-3"><path fill="currentColor" d="M8 1a3.5 3.5 0 0 0-3.5 3.5V6H4a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-.5V4.5A3.5 3.5 0 0 0 8 1Zm2 5H6V4.5a2 2 0 1 1 4 0V6Z"/></svg>
                        {p.domain}
                      </span>
                      <span class="w-10" aria-hidden="true"></span>
                    </div>
                    <img
                      src={p.img}
                      alt={`Captura de ${p.name}`}
                      loading="lazy"
                      decoding="async"
                      width="1600"
                      height="1000"
                      class={`aspect-[16/10] w-full object-cover ${p.fit ?? 'object-top'}`}
                    />
                  </a>
                  <div
                    class={`glass float-y pointer-events-none absolute -bottom-6 hidden rounded-2xl px-5 py-3.5 sm:block ${flip ? '-right-4 lg:-right-6' : '-left-4 lg:-left-6'}`}
                  >
                    <p class="text-xs font-medium text-ink-faint">{p.badge.k}</p>
                    <p class="font-display mt-0.5 text-lg font-semibold tracking-tight text-ink">{p.badge.v}</p>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- ============ CHERRY ============ -->
    <div class="mx-auto max-w-6xl px-5 pt-24 md:px-8 md:pt-40">
      <article id="cherry" class="cherry scroll-mt-28 overflow-hidden rounded-[2rem]" data-reveal>
        <div class="relative grid gap-10 p-7 md:p-12 lg:grid-cols-12 lg:gap-8 lg:p-14">
          <div class="relative z-10 lg:col-span-5">
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-xs font-semibold uppercase tracking-wider text-[#e0483a]">App móvil · Open source</span>
              <span class="inline-flex items-center gap-2 rounded-full bg-[#1d1426] px-3 py-1 text-xs font-semibold text-[#faf6f0]">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ffc53d]"></span>
                En construcción
              </span>
            </div>
            <h3 class="font-display mt-4 text-4xl font-semibold tracking-tight text-[#1d1426] md:text-6xl">Cherry</h3>
            <p class="font-display mt-3 text-xl font-medium leading-snug text-[#1d1426] md:text-2xl">
              Citas abiertas, hechas para las personas.
            </p>
            <p class="mt-5 leading-relaxed text-[#4a3d55]">
              Una app de citas open source y self-hosteable que demuestra que se puede servir a las personas en
              lugar de explotarlas: sin muros de pago, sin anuncios y sin trucos para retenerte. Lo que otras apps
              cobran, como ver quién te ha dado like, los filtros o deshacer, aquí viene incluido.
            </p>
            <ul class="mt-6 space-y-3">
              {[
                'Nativa en iOS y Android desde un único código',
                'Verificación de edad con el DNI y el NFC del móvil',
                'Pensada para que cada país pueda montar su propio Cherry',
              ].map((pt) => (
                <li class="flex gap-3 text-[15px] leading-snug text-[#1d1426]">
                  <span aria-hidden="true" class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#ff6b57]"></span>
                  {pt}
                </li>
              ))}
            </ul>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologías">
              {['Expo', 'React Native', 'Elixir', 'PostgreSQL + PostGIS'].map((s) => (
                <li class="rounded-full border border-[#1d1426]/15 bg-white/50 px-3 py-1 text-xs font-medium text-[#4a3d55]">{s}</li>
              ))}
            </ul>
          </div>
          <div class="relative lg:col-span-7 lg:-mr-24 lg:self-center">
            <img
              src="/images/proyectos/cherry-showcase.webp"
              alt="Cinco pantallas de Cherry: descubrir por etiquetas, quién te da like, chats, tu perfil y comprobación de edad"
              loading="lazy"
              decoding="async"
              width="1800"
              height="856"
              class="w-full drop-shadow-[0_30px_40px_rgba(29,20,38,0.18)]"
            />
          </div>
        </div>
      </article>
    </div>

    <!-- ============ HERRAMIENTAS ============ -->
    <div class="mx-auto max-w-6xl px-5 pb-24 pt-8 md:px-8 md:pb-36 md:pt-10">
      <div class="grid gap-8 md:grid-cols-2">
        <!-- AudiblePort -->
        <a
          id="audibleport"
          href="https://audibleport.com"
          target="_blank"
          rel="noopener"
          data-reveal
          class="group spot flex scroll-mt-28 flex-col overflow-hidden rounded-[1.75rem] border border-line bg-paper transition-[box-shadow,translate] duration-500 hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgba(12,21,38,0.35)]"
        >
          <div class="relative h-[250px] overflow-hidden bg-[#0d0b0a] px-6 pt-8 sm:h-[340px] sm:px-10 sm:pt-10">
            <div aria-hidden="true" class="absolute inset-0" style="background: radial-gradient(60% 70% at 70% 100%, rgb(255 110 30 / 0.35), transparent 70%);"></div>
            <img
              src="/images/proyectos/audibleport.webp"
              alt="Captura de AudiblePort"
              loading="lazy"
              decoding="async"
              width="1600"
              height="1000"
              class="relative h-full w-full rounded-t-xl object-cover object-left-top shadow-[0_-10px_50px_-10px_rgba(255,110,30,0.45)] transition-transform duration-700 group-hover:-translate-y-1.5"
            />
          </div>
          <div class="flex flex-1 flex-col p-7 md:p-9">
            <div class="flex items-center justify-between gap-4">
              <span class="text-xs font-semibold uppercase tracking-wider text-accent">Escritorio · Win, Mac y Linux</span>
              <span aria-hidden="true" class="text-xl text-ink-faint transition-colors group-hover:text-accent">↗</span>
            </div>
            <h3 class="font-display mt-3 text-3xl font-semibold tracking-tight text-ink">AudiblePort</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">
              Descarga tu biblioteca de Audible y conviértela a MP3 o M4B, en un único archivo o por capítulos.
              Todo en tu equipo: tus credenciales nunca salen de él. Licencia de pago único, sin suscripciones.
            </p>
            <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label="Tecnologías">
              {['Tauri', 'Rust', 'React', 'Phoenix'].map((s) => (
                <li class="rounded-full border border-line px-3 py-1 text-xs font-medium text-ink-soft">{s}</li>
              ))}
            </ul>
          </div>
        </a>

        <!-- TicketSplitter -->
        <a
          id="ticketsplitter"
          href="https://ticketsplitter.app"
          target="_blank"
          rel="noopener"
          data-reveal
          style="--reveal-delay: 100ms"
          class="group spot flex scroll-mt-28 flex-col overflow-hidden rounded-[1.75rem] border border-line bg-paper transition-[box-shadow,translate] duration-500 hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgba(12,21,38,0.35)]"
        >
          <div class="ts-stage relative flex h-[250px] items-start justify-center overflow-hidden px-6 pt-8 sm:h-[340px] sm:pt-10">
            <div aria-hidden="true" class="ts-dots absolute inset-0"></div>
            <!-- Móvil con un ticket compartido (ilustración) -->
            <div class="ts-phone relative w-[min(84%,300px)] transition-transform duration-700 group-hover:-translate-y-1.5" aria-hidden="true">
              <div class="rounded-t-[2rem] border-[6px] border-b-0 border-[#1b1830] bg-[#f7f7f9] px-4 pb-6 pt-4 text-[#16141f]">
