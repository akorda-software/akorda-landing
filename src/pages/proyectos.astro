---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import ProductRow, { type Product } from '../components/ProductRow.astro';

const icon = (id: string) => `/images/proyectos/iconos/${id}.webp`;

const products: Product[] = [
  {
    id: 'audibleport',
    name: 'AudiblePort',
    tag: 'Escritorio · Windows, macOS y Linux',
    tagline: 'Sé dueño de tus audiolibros.',
    desc: 'Descarga tu biblioteca de Audible y conviértela a MP3 o M4B, en un único archivo o por capítulos, con su reproductor integrado. Todo ocurre en tu equipo: tus credenciales de Audible nunca salen de él.',
    points: [
      'Tu biblioteca completa, con portadas, capítulos y metadatos',
      '100 % local y privado, sin servidores de por medio',
      'Licencia de pago único, sin suscripciones',
    ],
    status: 'En venta',
    href: 'https://audibleport.com',
    domain: 'audibleport.com',
    icon: icon('audibleport'),
    img: '/images/proyectos/audibleport.webp',
    kind: 'browser',
    glow: '255 110 30',
    badge: { k: 'Licencia', v: 'Pago único, para siempre' },
    fit: 'object-left-top',
  },
  {
    id: 'kordia',
    name: 'Kordia',
    tag: 'SaaS · Gestión de equipos',
    tagline: 'Reparte las horas de tu equipo entre proyectos.',
    desc: 'Planifica la capacidad y la carga de trabajo de tu equipo. Asignas personas a proyectos por jornada o por horas totales y ves al momento cuánto presupuesto, en horas y en euros, queda cubierto.',
    points: [
      'Detecta topes anuales y solapes antes de cerrar la planificación',
      'Presupuesto en horas y euros cubierto en tiempo real',
      'También se maneja desde tu asistente de IA',
    ],
    status: 'En producción',
    href: 'https://kordia.es',
    domain: 'kordia.es',
    icon: icon('kordia'),
    img: '/images/proyectos/kordia.webp',
    kind: 'browser',
    glow: '80 90 255',
    badge: { k: 'Sin hojas de cálculo', v: 'Sin solapes ni sorpresas' },
    fit: 'object-left-top',
  },
  {
    id: 'ticketsplitter',
    name: 'TicketSplitter',
    tag: 'Web y app móvil · IA',
    tagline: 'Divide la cuenta sin discutir.',
    desc: 'Haz una foto al ticket del restaurante y compártelo con un enlace o un QR. Cada uno marca desde su móvil lo que ha tomado, en tiempo real, y la app hace las cuentas. Nadie teclea, nadie discute.',
    points: [
      'La IA lee el ticket a partir de una simple foto',
      'Platos compartidos, a partes iguales o como quieras',
      'Sabes en todo momento quién ha pagado ya y quién no',
    ],
    status: 'En producción',
    href: 'https://ticketsplitter.app',
    domain: 'ticketsplitter.app',
    icon: icon('ticketsplitter'),
    img: '/images/proyectos/ticketsplitter-movil.webp',
    kind: 'phone',
    glow: '123 97 255',
    badge: { k: 'Disponible en', v: 'Web, iOS y Android' },
  },
  {
    id: 'kaselles',
    name: 'Kaselles',
    tag: 'Escritorio · IA',
    tagline: 'Tu horario no se hace. Se calcula.',
    desc: 'Generador de horarios para colegios, institutos, universidades, FP y academias. Describes tu centro a un agente de IA, revisas lo que ha configurado y un motor de optimización calcula un horario viable.',
    points: [
      'Respeta cada restricción del centro: profesores, aulas, grupos y reglas',
      'Un agente de IA configura el centro por ti a partir de tu descripción',
      'Proyectos locales: los datos del centro no salen de tu ordenador',
    ],
    status: 'Disponible',
    href: 'https://kaselles.com',
    domain: 'kaselles.com',
    icon: icon('kaselles'),
    img: '/images/proyectos/kaselles.webp',
    kind: 'browser',
    glow: '221 150 40',
    badge: { k: 'Plataformas', v: 'Windows · macOS · Linux' },
  },
  {
    id: 'taket',
    name: 'Taket',
    tag: 'SaaS · Eventos',
    tagline: 'La puerta de tu evento, bajo control.',
    desc: 'Control de acceso y aforo por QR. Importas la lista de asistentes, envías las entradas y escaneas con cualquier móvil, también sin conexión. Sabes quién ha entrado, cuánta gente hay dentro y tienes el informe al terminar.',
    points: [
      'Nació para un evento corporativo real de unas 3.500 personas',
      'Varias puertas a la vez, aforo en directo y modo sin conexión',
      'Sin lectores, sin hardware propio y sin comisión por entrada',
    ],
    status: 'En producción',
    href: 'https://taket.app',
    domain: 'taket.app',
    icon: icon('taket'),
    img: '/images/proyectos/taket.webp',
    phone: '/images/proyectos/taket-movil.webp',
    kind: 'browser',
    glow: '76 205 115',
    badge: { k: 'Pruebas de carga', v: '~200 escaneos/s' },
  },
];

const amigoinvisible: Product = {
  id: 'amigoinvisible',
  name: 'Amigo invisible',
  tag: 'Web · Gratis',
  tagline: 'El sorteo de siempre, con chat secreto.',
  desc: 'Organiza el amigo invisible online: creas el grupo, invitas por email o con un enlace y sorteas. Después, cada uno tiene dos chats anónimos, con la persona a la que regala y con quien le regala, para acertar con el regalo sin descubrirse.',
  points: [
    'Bloquea parejas o repetir el regalo del año pasado; el sorteo lo respeta',
    'Si alguien se va tras el sorteo, la cadena se repara sin volver a sortear',
    'Modalidad clásica o a ciegas, por colores',
  ],
  status: 'En producción',
  href: 'https://amigoinvisible.akorda.es',
  domain: 'amigoinvisible.akorda.es',
  icon: icon('amigoinvisible'),
  img: '/images/proyectos/amigoinvisible.webp',
  phone: '/images/proyectos/amigoinvisible-movil.webp',
  kind: 'browser',
  glow: '255 210 63',
  badge: { k: 'Precio', v: 'Gratis y sin anuncios' },
};

const dragonex: Product = {
  id: 'dragonex',
  name: 'Dragonex',
  tag: 'Juego web · IA',
  tagline: 'Un máster de rol que no hace trampas con los dados.',
  desc: 'Partidas de Dungeons & Dragons 5e dirigidas por IA, solo o con amigos. La IA solo narra: cada tirada, ataque y salvación la resuelve un motor que aplica las reglas. La historia es libre; los números, honestos.',
  points: [
    'Agentes de IA con herramientas: la IA narra y el código arbitra',
    'Construido sobre nuestro propio framework de agentes de IA',
    'Personajes humanos o controlados por IA en la misma mesa',
  ],
  status: 'En producción',
  href: 'https://dragones.kukapu.dev',
  domain: 'dragones.kukapu.dev',
  icon: icon('dragonex'),
  img: '/images/proyectos/dragonex.webp',
  kind: 'browser',
  glow: '255 120 40',
  badge: { k: 'Pruebas automáticas', v: '+3.300 en cada despliegue' },
};

const all = [...products, { id: 'cherry', name: 'Cherry', icon: icon('cherry') }, amigoinvisible, dragonex];

const stats = [
  { n: '8', label: 'productos propios' },
  { n: '7', label: 'ya publicados y en uso' },
  { n: '3', label: 'proyectos a medida en marcha' },
  { n: '3', label: 'plataformas: web, escritorio y móvil' },
];

const clients = [
  {
    name: 'Mercury Brokers',
    sector: 'Seguros de transporte',
    logo: '/images/proyectos/iconos/mercury-brokers.png',
    status: 'En pruebas',
    before: 'Expedientes, facturas y certificados de seguro de mercancías preparados a mano, documento a documento.',
    after: 'Un backoffice que lee la documentación con IA, calcula primas y genera certificados y recibos, siempre con revisión humana, tarifas versionadas y auditoría.',
  },
  {
    name: 'CodiSL',
    sector: 'Construcción',
    logo: '/images/proyectos/iconos/codisl.png',
    status: 'En desarrollo',
    before: 'Varias hojas de cálculo para costes de obra, facturación y nóminas que había que cuadrar entre sí.',
    after: 'Una aplicación interna centrada en la obra: operarios, materiales y autónomos, facturación, margen y liquidación mensual en un único lugar.',
  },
  {
    name: 'AquaSalud',
    sector: 'Tratamiento de agua',
    logo: '/images/proyectos/iconos/aquasalud.webp',
    status: 'En desarrollo',
    before: 'Una aplicación antigua sobre la que la empresa había perdido el control.',
    after: 'Un mini-ERP hecho a medida que le devuelve el control sobre su herramienta y sobre sus datos.',
  },
];
---

<BaseLayout
  title="Proyectos"
  description="Productos propios de akorda: AudiblePort, Kordia, TicketSplitter, Kaselles, Taket, Cherry, Amigo invisible y Dragonex. Y software a medida en marcha con clientes como Mercury Brokers y CodiSL."
>
  <!-- ============ HERO ============ -->
  <section id="hero" class="relative overflow-hidden pt-16 md:pt-[72px]">
    <div aria-hidden="true" class="absolute inset-0" data-parallax="0.06">
      <div class="aurora">
        <div class="blob blob-a"><div data-depth="10"><i></i></div></div>
        <div class="blob blob-b"><div data-depth="22"><i></i></div></div>
        <div class="blob blob-c"><div data-depth="14"><i></i></div></div>
      </div>
    </div>
    <div aria-hidden="true" class="absolute inset-0" data-parallax="0.12">
      <div class="hero-grid absolute inset-0"></div>
      <div class="dot-grid absolute inset-0"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-16 md:px-8 md:pb-24 md:pt-24">
      <div data-hero-fade>
        <p
          class="hero-enter inline-flex items-center gap-2 rounded-full border border-line bg-paper/80 px-4 py-1.5 text-sm font-medium text-ink-soft backdrop-blur"
        >
          <span class="h-2 w-2 rounded-full bg-accent"></span>
          Proyectos
        </p>
        <h1
          class="hero-enter font-display mt-7 max-w-4xl text-[2.6rem] font-semibold leading-[1.04] tracking-tight text-ink md:text-7xl"
          style="--enter-delay: 80ms"
        >
          Lo que construimos <span class="italic text-accent">habla por nosotros</span>.
        </h1>
        <p class="hero-enter mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl" style="--enter-delay: 160ms">
          Productos propios que hemos diseñado, lanzado y mantenemos, y los primeros proyectos a medida con
          clientes. Todavía no tenemos casos de cliente terminados que contar; lo que sí tenemos es software
          real, en producción, que puedes probar ahora mismo.
        </p>

        <dl
          class="hero-enter mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4"
          style="--enter-delay: 240ms"
        >
          {stats.map((s) => (
            <div class="bg-paper/85 px-5 py-5 backdrop-blur md:px-6 md:py-6">
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-semibold tracking-tight text-ink md:text-5xl">{s.n}</dd>
              <dd class="mt-1 text-sm leading-snug text-ink-soft">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ CINTA DE PRODUCTOS (índice) ============ -->
  <nav class="marquee overflow-hidden border-y border-line bg-paper-deep py-4" aria-label="Índice de productos">
    <div class="marquee-track flex w-max items-center gap-12 pr-12" style="--marquee-duration: 45s">
      {[...all, ...all, ...all, ...all].map((p, i) => (
        <a
          href={`#${p.id}`}
          class="group flex shrink-0 items-center gap-3 whitespace-nowrap"
          tabindex={i < all.length ? 0 : -1}
          aria-hidden={i < all.length ? undefined : 'true'}
        >
          <img src={p.icon} alt="" width="36" height="36" class="app-icon h-9 w-9" />
          <span class="font-display text-lg font-semibold tracking-tight text-ink-soft transition-colors group-hover:text-ink">{p.name}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- ============ PRODUCTOS PROPIOS ============ -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-5 pt-20 md:px-8 md:pt-32">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Productos propios</p>
        <h2 class="font-display mt-5 text-3xl font-semibold tracking-tight text-ink md:text-5xl">
          Nadie nos los encargó. Por eso son la mejor prueba.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">
          Los hemos llevado de la idea a producción con nuestro tiempo y nuestro dinero: diseño, desarrollo,
          puesta en marcha, cobros y soporte. Es exactamente lo que haríamos con tu proyecto.
        </p>
      </div>

      <div class="mt-16 space-y-24 md:mt-24 md:space-y-36">
        {products.map((p, i) => <ProductRow p={p} flip={i % 2 === 1} />)}
      </div>
    </div>

    <!-- ============ CHERRY ============ -->
    <div class="mx-auto max-w-6xl px-5 pt-24 md:px-8 md:pt-40">
      <article id="cherry" class="cherry scroll-mt-28 overflow-hidden rounded-[2rem]" data-reveal>
        <div class="relative grid gap-10 p-7 md:p-12 lg:grid-cols-12 lg:gap-8 lg:p-14">
          <div class="relative z-10 lg:col-span-5">
            <div class="flex items-center gap-4">
              <img src={icon('cherry')} alt="" width="64" height="64" class="app-icon h-14 w-14 md:h-16 md:w-16" />
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-[#e0483a]">App móvil · Open source</span>
                <span class="mt-1.5 inline-flex items-center gap-2 rounded-full bg-[#1d1426] px-3 py-1 text-xs font-semibold text-[#faf6f0]">
                  <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[#b9e53c]"></span>
                  En preparación
                </span>
              </div>
            </div>
            <h3 class="font-display mt-6 text-4xl font-semibold tracking-tight text-[#1d1426] md:text-6xl">Cherry</h3>
            <p class="font-display mt-3 text-xl font-medium leading-snug text-[#1d1426] md:text-2xl">
              La app para conocer gente <span class="cherry-mark">que es de todos.</span>
            </p>
            <p class="mt-5 leading-relaxed text-[#4a3d55]">
              Todo el mundo tiene la app entera, sin límites ni letra pequeña, y siempre sabes por qué ves a cada
              persona. Sin muros de pago, sin anuncios y sin trucos para retenerte. Pareja, algo casual, amistad o a
              ver qué pasa: tú decides.
            </p>
            <ul class="mt-6 space-y-3">
              {[
                'Nativa en iOS y Android',
                'Verificación de edad con el DNI y el NFC del móvil',
                'Open source: cada país puede tener su propio Cherry',
              ].map((pt) => (
                <li class="flex gap-3 text-[15px] leading-snug text-[#1d1426]">
                  <span aria-hidden="true" class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-[#ff6b57]"></span>
                  {pt}
                </li>
              ))}
            </ul>
            <a
              href="https://cherry.org.es"
              target="_blank"
              rel="noopener"
              data-magnetic
              class="group mt-8 inline-flex items-center gap-2 rounded-full border-2 border-[#1d1426] bg-[#ff6b57] px-5 py-2.5 text-sm font-bold text-[#1d1426] shadow-[3px_3px_0_#1d1426] transition-[box-shadow,translate] hover:shadow-[1px_1px_0_#1d1426]"
            >
              Visitar cherry.org.es
              <span aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
            </a>
          </div>
          <div class="relative lg:col-span-7 lg:-mr-24 lg:self-center">
            <img
              src="/images/proyectos/cherry-showcase.webp"
              alt="Cinco pantallas de Cherry: descubrir por etiquetas, quién te da like, chats, tu perfil y comprobación de edad"
              loading="lazy"
              decoding="async"
              width="1800"
              height="856"
              class="w-full drop-shadow-[0_30px_40px_rgba(29,20,38,0.18)]"
            />
          </div>
        </div>
      </article>
    </div>

    <!-- ============ AMIGO INVISIBLE ============ -->
    <div class="mx-auto max-w-6xl px-5 pt-24 md:px-8 md:pt-40">
      <ProductRow p={amigoinvisible} flip={products.length % 2 === 1} />
    </div>

    <!-- ============ DRAGONEX ============ -->
    <div class="mx-auto max-w-6xl px-5 pb-24 pt-24 md:px-8 md:pb-36 md:pt-40">
      <ProductRow p={dragonex} flip={products.length % 2 === 0} />
    </div>
  </section>

  <!-- ============ CON CLIENTES ============ -->
  <section id="clientes" class="relative scroll-mt-16 overflow-hidden border-y border-line bg-paper-deep">
    <div aria-hidden="true" class="absolute inset-0" data-parallax="0.08">
      <span class="orb left-[-160px] top-[10%] h-[400px] w-[400px]" style="background: radial-gradient(closest-side, var(--aur-1), transparent 70%);"></span>
      <span class="orb bottom-[-180px] right-[-140px] h-[460px] w-[460px]" style="background: radial-gradient(closest-side, var(--aur-4), transparent 70%);"></span>
    </div>
    <div class="relative mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-32">
      <div class="grid gap-6 md:grid-cols-[1.2fr_1fr] md:items-end" data-reveal>
        <div>
          <p class="eyebrow">Con clientes</p>
          <h2 class="font-display mt-5 text-3xl font-semibold tracking-tight text-ink md:text-5xl">
            En marcha con clientes.
          </h2>
        </div>
        <p class="leading-relaxed text-ink-soft">
          Nuestros primeros proyectos a medida, ahora en desarrollo. Cuando terminen los contaremos aquí con
          detalle: el problema, las decisiones y el resultado.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:mt-16 lg:grid-cols-3">
        {clients.map((c, i) => (
          <article
            data-reveal
            style={`--reveal-delay: ${i * 90}ms`}
            class="spot flex flex-col rounded-[1.5rem] border border-line bg-paper p-7 md:p-8"
          >
            <div class="client-logo grid h-16 w-fit min-w-16 place-items-center rounded-2xl px-4">
              {c.logo ? (
                <img src={c.logo} alt={`Logotipo de ${c.name}`} class="max-h-10 w-auto max-w-[170px] object-contain" loading="lazy" />
              ) : (
                <span class="font-display text-2xl font-bold tracking-tight text-[#0e7490]" aria-hidden="true">AS</span>
              )}
            </div>
            <div class="mt-6 flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-faint">{c.sector}</p>
              <span class="inline-flex items-center gap-2 rounded-full bg-accent-tint px-3 py-1 text-xs font-semibold text-accent-strong">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
                {c.status}
              </span>
            </div>
            <h3 class="font-display mt-1.5 text-2xl font-semibold tracking-tight text-ink">{c.name}</h3>
            <div class="mt-6 grid flex-1 content-start gap-4">
              <div class="rounded-xl border border-dashed border-line px-4 py-3.5">
                <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-faint">Antes</p>
                <p class="mt-1 text-[15px] leading-relaxed text-ink-soft">{c.before}</p>
              </div>
              <div class="relative rounded-xl border border-accent/25 bg-accent-tint/60 px-4 py-3.5">
                <span aria-hidden="true" class="absolute -top-[13px] left-6 grid h-6 w-6 place-items-center rounded-full border border-line bg-paper text-xs text-accent">↓</span>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-accent">Lo que construimos</p>
                <p class="mt-1 text-[15px] leading-relaxed text-ink">{c.after}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="El próximo puede ser el tuyo."
    body="Cuéntanos tu idea o tu problema, cómo lo haces hoy y qué te gustaría que cambiara. Te diremos con honestidad si podemos ayudar, y cómo."
  />
</BaseLayout>

<style>
  /* Iconos de app: misma forma para todos los productos (también en ProductRow) */
  :global(.app-icon) {
    border-radius: 23%;
    box-shadow:
      0 0 0 1px rgb(12 21 38 / 0.08),
      0 8px 20px -10px rgb(12 21 38 / 0.45);
  }

  :global([data-theme='dark'] .app-icon) {
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 8px 20px -10px rgb(0 0 0 / 0.8);
  }

  /* Logos de clientes: siempre sobre blanco para respetar sus colores */
  .client-logo {
    background: #fff;
    border: 1px solid var(--color-line);
  }

  /* Cherry: bloque con su propia identidad, igual en claro y oscuro */
  .cherry {
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(255 107 87 / 0.22), transparent 60%),
      radial-gradient(60% 80% at 80% 100%, rgb(165 139 255 / 0.25), transparent 60%),
      #faf6f0;
    border: 1px solid rgb(29 20 38 / 0.08);
    position: relative;
  }

  .cherry::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgb(29 20 38 / 0.09) 1px, transparent 1.4px);
    background-size: 22px 22px;
    pointer-events: none;
  }

  .cherry-mark {
    background: #ffc53d;
    padding: 0 0.2em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>
