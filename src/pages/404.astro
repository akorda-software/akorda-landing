---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o ha cambiado de dirección."
  noindex
>
  <section class="mx-auto max-w-3xl px-5 pb-24 pt-40 text-center md:px-8 md:pt-56">
    <p class="font-display text-sm font-semibold tracking-widest text-accent">ERROR 404</p>
    <h1 class="hero-enter font-display mt-4 text-4xl font-semibold tracking-tight text-ink md:text-6xl">
      Aquí no hay nada que resolver.
    </h1>
    <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-ink-soft">
      La página que buscas no existe o ha cambiado de dirección. Volvamos a terreno conocido.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-ink px-6 py-3 font-medium text-paper transition-all hover:bg-accent active:scale-[0.98]"
      >
        Volver al inicio
      </a>
      <a
        href="/contacto"
        class="rounded-full border border-line bg-paper px-6 py-3 font-medium text-ink transition-colors hover:border-ink"
      >
        Cuéntanos tu problema
      </a>
    </div>
  </section>
</BaseLayout>
